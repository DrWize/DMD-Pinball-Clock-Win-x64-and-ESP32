<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DmdClock.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="256"
        x:Class="DmdClock.App.MainWindow"
        Title="DMD Clock"
        Icon="/Assets/dmdclock.ico"
        Width="1024"
        Height="256"
        MinWidth="51"
        MinHeight="13"
        Background="Black">
    <Border Background="Black" BorderBrush="#080808" BorderThickness="3" Padding="3">
        <Grid>
        <controls:DmdDisplay x:Name="Display" PointerPressed="Display_PointerPressed">
            <controls:DmdDisplay.ContextMenu>
                <ContextMenu x:Name="MainContextMenu" Opened="MainContextMenu_Opened">
                    <ContextMenu.Styles>
                        <Style Selector="MenuItem">
                            <Setter Property="StaysOpenOnClick" Value="True" />
                        </Style>
                    </ContextMenu.Styles>
                    <MenuItem Header="Open SCN file… (Ctrl+O)" Click="OpenScene_Click" />
                    <MenuItem Header="Choose animation folder… (Ctrl+Shift+O)" Click="ChooseFolder_Click" />
                    <MenuItem Header="Download DotClk scenes…" Click="DownloadScenes_Click" />
                    <MenuItem Header="Rescan library (F5)" Click="Rescan_Click" />
                    <MenuItem Header="Review and choose scenes… (Ctrl+Shift+R)" Click="SceneReviewer_Click" />
                    <Separator />
                    <MenuItem Header="Play/pause (Space)" Click="PlayPause_Click" />
                    <MenuItem Header="Next frame (Right)" Click="NextFrame_Click" />
                    <MenuItem Header="Previous frame (Left)" Click="PreviousFrame_Click" />
                    <MenuItem Header="Next animation (N)" Click="NextAnimation_Click" />
                    <MenuItem Header="Previous animation (P)" Click="PreviousAnimation_Click" />
                    <MenuItem x:Name="RandomMenuItem" Header="Random order" Click="RandomMode_Click" />
                    <MenuItem x:Name="AutomaticCycleMenuItem" Header="Automatic clock/animation cycle" Click="AutomaticCycle_Click" />
                    <MenuItem x:Name="AnimationInfoMenuItem" Header="Animation information (I)" Click="AnimationInfo_Click" />
                    <MenuItem Header="Animations per cycle">
                        <MenuItem x:Name="Animations1MenuItem" Header="1 animation" Click="Animations1_Click" />
                        <MenuItem x:Name="Animations3MenuItem" Header="3 animations" Click="Animations3_Click" />
                        <MenuItem x:Name="Animations5MenuItem" Header="5 animations" Click="Animations5_Click" />
                    </MenuItem>
                    <MenuItem Header="Time between animations">
                        <MenuItem x:Name="AnimationGap0MenuItem" Header="No pause" Click="AnimationGap0_Click" />
                        <MenuItem x:Name="AnimationGap5MenuItem" Header="5 seconds" Click="AnimationGap5_Click" />
                        <MenuItem x:Name="AnimationGap10MenuItem" Header="10 seconds" Click="AnimationGap10_Click" />
                        <MenuItem x:Name="AnimationGap30MenuItem" Header="30 seconds" Click="AnimationGap30_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Appearance">
                        <MenuItem x:Name="ColorsMenuItem" Header="Colors">
                            <MenuItem x:Name="BasicColorsMenuItem" Header="Basic colors">
                                <MenuItem x:Name="AppearanceOrangeMenuItem" Header="Classic orange" Click="AppearanceOrange_Click" />
                                <MenuItem x:Name="AppearanceAmberMenuItem" Header="Golden amber" Click="AppearanceAmber_Click" />
                                <MenuItem x:Name="AppearanceRedMenuItem" Header="Pinball red" Click="AppearanceRed_Click" />
                                <MenuItem x:Name="AppearanceGreenMenuItem" Header="Arcade green" Click="AppearanceGreen_Click" />
                                <MenuItem x:Name="AppearanceBlueMenuItem" Header="Electric blue" Click="AppearanceBlue_Click" />
                                <MenuItem x:Name="AppearanceCyanMenuItem" Header="Ice cyan" Click="AppearanceCyan_Click" />
                                <MenuItem x:Name="AppearanceMagentaMenuItem" Header="Hot magenta" Click="AppearanceMagenta_Click" />
                                <MenuItem x:Name="AppearanceMonochromeMenuItem" Header="Warm white" Click="AppearanceMonochrome_Click" />
                                <Separator />
                                <MenuItem x:Name="BasicCustomMenuItem" Header="Custom…" Click="ForegroundColor_Click" />
                            </MenuItem>
                            <MenuItem x:Name="PlasmaMenuItem" Header="Plasma">
                                <MenuItem x:Name="PlasmaPaletteMenuItem" Header="Palette">
                                    <MenuItem x:Name="PlasmaNeonMenuItem" Header="Neon pulse" Click="PlasmaNeon_Click" />
                                    <MenuItem x:Name="PlasmaLavaMenuItem" Header="Lava flow" Click="PlasmaLava_Click" />
                                    <MenuItem x:Name="PlasmaOceanMenuItem" Header="Deep ocean" Click="PlasmaOcean_Click" />
                                    <MenuItem x:Name="PlasmaAuroraMenuItem" Header="Aurora drift" Click="PlasmaAurora_Click" />
                                    <MenuItem x:Name="PlasmaToxicMenuItem" Header="Toxic slime" Click="PlasmaToxic_Click" />
                                    <MenuItem x:Name="PlasmaVaporMenuItem" Header="Vapor dream" Click="PlasmaVapor_Click" />
                                    <MenuItem x:Name="PlasmaSolarMenuItem" Header="Solar flare" Click="PlasmaSolar_Click" />
                                    <MenuItem x:Name="PlasmaArcticMenuItem" Header="Arctic ice" Click="PlasmaArctic_Click" />
                                    <Separator />
                                    <MenuItem x:Name="PlasmaCustomMenuItem" Header="Custom palette…" Click="PlasmaCustom_Click" />
                                </MenuItem>
                                <MenuItem x:Name="PlasmaSpeedMenuItem" Header="Speed">
                                    <MenuItem x:Name="PlasmaSlowMenuItem" Header="Slow — 16 seconds" Click="PlasmaSlow_Click" />
                                    <MenuItem x:Name="PlasmaNormalMenuItem" Header="Normal — 8 seconds" Click="PlasmaNormal_Click" />
                                    <MenuItem x:Name="PlasmaFastMenuItem" Header="Fast — 4 seconds" Click="PlasmaFast_Click" />
                                    <MenuItem x:Name="PlasmaVeryFastMenuItem" Header="Very fast — 2 seconds" Click="PlasmaVeryFast_Click" />
                                    <Separator />
                                    <MenuItem x:Name="PlasmaCustomSpeedMenuItem" Header="Custom…" Click="PlasmaCustomSpeed_Click" />
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="GradientThemesMenuItem" Header="Gradient themes">
                                <MenuItem x:Name="AppearanceNeonSunsetMenuItem" Header="Neon sunset" Click="AppearanceNeonSunset_Click" />
                                <MenuItem x:Name="AppearanceCyberOceanMenuItem" Header="Cyber ocean" Click="AppearanceCyberOcean_Click" />
                                <MenuItem x:Name="AppearanceToxicArcadeMenuItem" Header="Toxic arcade" Click="AppearanceToxicArcade_Click" />
                                <MenuItem x:Name="AppearanceVaporwaveMenuItem" Header="Vaporwave" Click="AppearanceVaporwave_Click" />
                                <MenuItem x:Name="AppearanceAuroraMenuItem" Header="Aurora" Click="AppearanceAurora_Click" />
                                <MenuItem x:Name="AppearanceFirestormMenuItem" Header="Firestorm" Click="AppearanceFirestorm_Click" />
                                <MenuItem x:Name="AppearanceElectricVioletMenuItem" Header="Electric violet" Click="AppearanceElectricViolet_Click" />
                                <MenuItem x:Name="AppearanceArcticGlowMenuItem" Header="Arctic glow" Click="AppearanceArcticGlow_Click" />
                            </MenuItem>
                            <MenuItem x:Name="RasterThemesMenuItem" Header="Raster themes">
                                <MenuItem x:Name="AppearanceC64BlueRoundMenuItem" Header="Blue halo" Click="AppearanceC64BlueRound_Click" />
                                <MenuItem x:Name="AppearanceC64RedRoundMenuItem" Header="Red halo" Click="AppearanceC64RedRound_Click" />
                                <MenuItem x:Name="AppearanceC64EarthtoneMenuItem" Header="Earthtone" Click="AppearanceC64Earthtone_Click" />
                                <MenuItem x:Name="AppearanceC64MetalMenuItem" Header="Metal" Click="AppearanceC64Metal_Click" />
                                <MenuItem x:Name="AppearanceC64InterlacedBlueMenuItem" Header="Interlaced blue" Click="AppearanceC64InterlacedBlue_Click" />
                                <MenuItem x:Name="AppearanceC64ExtrudedCyanMenuItem" Header="Extruded cyan" Click="AppearanceC64ExtrudedCyan_Click" />
                                <MenuItem x:Name="AppearanceC64RainbowMenuItem" Header="Rainbow" Click="AppearanceC64Rainbow_Click" />
                                <MenuItem x:Name="AppearanceC64PurpleHaloMenuItem" Header="Purple halo" Click="AppearanceC64PurpleHalo_Click" />
                                <MenuItem x:Name="AppearanceRasterGreenHaloMenuItem" Header="Green halo" Click="AppearanceRasterGreenHalo_Click" />
                                <MenuItem x:Name="AppearanceRasterAmberHaloMenuItem" Header="Amber halo" Click="AppearanceRasterAmberHalo_Click" />
                                <MenuItem x:Name="AppearanceRasterPurplePulseMenuItem" Header="Purple pulse" Click="AppearanceRasterPurplePulse_Click" />
                                <MenuItem x:Name="AppearanceRasterOceanDepthMenuItem" Header="Ocean depth" Click="AppearanceRasterOceanDepth_Click" />
                                <MenuItem x:Name="AppearanceRasterSunsetBandsMenuItem" Header="Sunset bands" Click="AppearanceRasterSunsetBands_Click" />
                                <MenuItem x:Name="AppearanceRasterForestLayersMenuItem" Header="Forest layers" Click="AppearanceRasterForestLayers_Click" />
                                <MenuItem x:Name="AppearanceRasterArcticBandsMenuItem" Header="Arctic bands" Click="AppearanceRasterArcticBands_Click" />
                                <MenuItem x:Name="AppearanceRasterCandyStripeMenuItem" Header="Candy stripe" Click="AppearanceRasterCandyStripe_Click" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="BackgroundMenuItem" Header="Background">
                                <MenuItem x:Name="BackgroundThemeMenuItem" Header="Theme default" Click="BackgroundTheme_Click" />
                                <MenuItem x:Name="BackgroundBlackMenuItem" Header="Black" Click="BackgroundBlack_Click" />
                                <MenuItem x:Name="BackgroundCustomMenuItem" Header="Custom…" Click="BackgroundColor_Click" />
                            </MenuItem>
                            <MenuItem x:Name="ResetCustomColorsMenuItem" Header="Reset custom colors" Click="ResetCustomColors_Click" />
                        </MenuItem>
                        <MenuItem Header="Brightness">
                            <MenuItem x:Name="Brightness25MenuItem" Header="25 %" Click="Brightness25_Click" />
                            <MenuItem x:Name="Brightness50MenuItem" Header="50 %" Click="Brightness50_Click" />
                            <MenuItem x:Name="Brightness75MenuItem" Header="75 %" Click="Brightness75_Click" />
                            <MenuItem x:Name="Brightness100MenuItem" Header="100 %" Click="Brightness100_Click" />
                        </MenuItem>
                        <MenuItem x:Name="GlowMenuItem" Header="Glow" Click="Glow_Click" />
                        <MenuItem x:Name="ShowTitleBarMenuItem" Header="Show title bar" Click="ShowTitleBar_Click" />
                        <MenuItem x:Name="DisplaySizeMenuItem" Header="Display size">
                            <MenuItem Header="Increase size/zoom (+)" Click="IncreaseDisplaySize_Click" />
                            <MenuItem Header="Decrease size/zoom (-)" Click="DecreaseDisplaySize_Click" />
                            <MenuItem Header="Reset size/zoom (0)" Click="ResetDisplaySize_Click" />
                        </MenuItem>
                        <MenuItem Header="Clock">
                            <MenuItem Header="Show clock (T)" Click="ShowTime_Click" />
                            <MenuItem x:Name="ShowSecondsMenuItem" Header="Show seconds" Click="ShowSeconds_Click" />
                            <MenuItem Header="Clock duration">
                                <MenuItem x:Name="ClockTime10MenuItem" Header="10 seconds" Click="ClockTime10_Click" />
                                <MenuItem x:Name="ClockTime30MenuItem" Header="30 seconds" Click="ClockTime30_Click" />
                                <MenuItem x:Name="ClockTime60MenuItem" Header="60 seconds" Click="ClockTime60_Click" />
                            </MenuItem>
                            <MenuItem Header="Time format">
                                <MenuItem x:Name="Clock24MenuItem" Header="24-hour" Click="Clock24_Click" />
                                <MenuItem x:Name="Clock12MenuItem" Header="12-hour (AM/PM)" Click="Clock12_Click" />
                            </MenuItem>
                            <MenuItem x:Name="ClockFontMenuItem" Header="Font" />
                        </MenuItem>
                        <MenuItem Header="Date">
                            <MenuItem Header="Show date (D)" Click="ShowDate_Click" />
                            <MenuItem Header="Date format">
                                <MenuItem x:Name="DateIsoMenuItem" Header="YYYY-MM-DD (ISO)" Click="DateIso_Click" />
                                <MenuItem x:Name="DateEuropeanMenuItem" Header="DD/MM/YYYY" Click="DateEuropean_Click" />
                                <MenuItem x:Name="DateUsMenuItem" Header="MM/DD/YYYY" Click="DateUs_Click" />
                                <MenuItem x:Name="DateDotsMenuItem" Header="DD.MM.YYYY" Click="DateDots_Click" />
                            </MenuItem>
                            <MenuItem x:Name="DateFontMenuItem" Header="Font" />
                        </MenuItem>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Fullscreen (F11)" Click="Fullscreen_Click" />
                    <Separator />
                    <MenuItem Header="Language">
                        <MenuItem x:Name="EnglishLanguageMenuItem" Header="English" Click="EnglishLanguage_Click" />
                        <MenuItem x:Name="SwedishLanguageMenuItem" Header="Swedish" Click="SwedishLanguage_Click" />
                    </MenuItem>
                    <MenuItem Header="Help – Alien Tech on GitHub" Click="HelpGitHub_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </controls:DmdDisplay.ContextMenu>
        </controls:DmdDisplay>
        <Border x:Name="AnimationInfoOverlay"
                IsVisible="False"
                IsHitTestVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="420"
                Margin="0,0,10,8"
                Padding="8,5"
                CornerRadius="3"
                Background="#C0000000">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock x:Name="AnimationGameText"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Inter"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFF2D2" />
                <TextBlock x:Name="AnimationSequenceText"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Inter"
                           FontSize="10"
                           Foreground="#D8FFFFFF" />
            </StackPanel>
        </Border>
        <Border x:Name="StartupBrandOverlay"
                Background="#E6000000">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7">
                <TextBlock Text="Alien Tech"
                           HorizontalAlignment="Center"
                           FontFamily="Inter"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#FFFFA126" />
                <TextBlock x:Name="StartupAnimationCountText"
                           Text="Loading animations…"
                           HorizontalAlignment="Center"
                           FontFamily="Inter"
                           FontSize="12"
                           Foreground="#D8FFFFFF" />
                <TextBlock x:Name="StartupBuildText"
                           Text="Build … · checking for updates"
                           HorizontalAlignment="Center"
                           FontFamily="Inter"
                           FontSize="10"
                           Foreground="#B8FFFFFF" />
                <TextBlock Text="DrWize - DMD Pinball Clock Win x64 and ESP32"
                           HorizontalAlignment="Center"
                           FontFamily="Inter"
                           FontSize="10"
                           Foreground="#B8FFFFFF"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           ToolTip.Tip="https://github.com/DrWize/DMD-Pinball-Clock-Win-x64-and-ESP32"
                           PointerPressed="StartupCredit_PointerPressed" />
            </StackPanel>
        </Border>
        <Border x:Name="UpdateAvailableOverlay"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="8"
                Padding="12,7"
                CornerRadius="6"
                Background="#ED5A3100"
                BorderBrush="#FFFFA126"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip.Tip="Open the latest DMDClock release"
                PointerPressed="UpdateAvailable_PointerPressed">
            <TextBlock x:Name="UpdateAvailableText"
                       FontFamily="Inter"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFFFE0B8" />
        </Border>
        </Grid>
    </Border>
</Window>
